# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงทั้งหมด ห้าม commit .env ขึ้น git

# จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=


# เลือก provider ของ AI: "gemini" (ฟรี ไม่ต้องผูกบัตร) หรือ "anthropic" (เสียเงินตาม token)
AI_PROVIDER=gemini

# ใช้เมื่อ AI_PROVIDER=gemini — ขอฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ใช้เมื่อ AI_PROVIDER=anthropic — จาก https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# พอร์ตที่ server รัน (hosting ส่วนใหญ่กำหนดให้เองผ่าน process.env.PORT)
PORT=3000

# เวลาที่จะส่งดวงประจำวันทุกเช้า (เวลาไทย, 24 ชม.)
DAILY_PUSH_HOUR=7
DAILY_PUSH_MINUTE=0

# หน่วงเวลาระหว่างส่งแต่ละคนตอน push ทุกเช้า (มิลลิวินาที)
# ใช้ Gemini ฟรีเทียร์ (~10-15 req/นาที) ตั้งอย่างน้อย 4500-6000 เพื่อไม่ให้โดน rate limit
# ใช้ Anthropic paid ตั้ง 0 หรือค่าต่ำได้เลย
DAILY_PUSH_DELAY_MS=5000
